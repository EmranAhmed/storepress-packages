{
	"name": "storepress-packages",
	"version": "0.0.6",
	"private": true,
	"type": "module",
	"description": "StorePress Packages",
	"author": "StorePress",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"StorePress"
	],
	"workspaces": [
		"packages/*"
	],
	"dependencies": {
		"@storepress/components": "file:packages/components",
		"@storepress/icons": "file:packages/icons",
		"@storepress/utils": "file:packages/utils"
	},
	"scripts": {
		"storybook": "storybook dev -p 6007",
		"storybook-docs": "storybook dev --docs",
		"build-storybook-docs": "storybook build --docs",
		"build-storybook": "storybook build",
		"build": "npm run build --workspaces --if-present",
		"test": "wp-scripts test-unit-jest --config jest.config.cjs",
		"test:single": "wp-scripts test-unit-jest --config jest.config.cjs packages/utils/tests/dom.test.js",
		"test:coverage": "wp-scripts test-unit-jest --config jest.config.cjs --coverage",
		"test:debug": "wp-scripts test-unit-jest --config jest.config.cjs --verbose",
		"postbuild": "node ./bin/build-style.cjs",
		"format": "wp-scripts format './packages/**/src/**/*.js'",
		"lint:css": "wp-scripts lint-style './packages/**/src/**/*.scss'",
		"lint:js": "wp-scripts lint-js --format=pretty './packages/**/src/**/*.js'",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css:fix": "npm run lint:css -- --fix"
	},
	"devDependencies": {
		"@storepress/tooltip": "^0.11.0",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-webpack5-compiler-babel": "4.0.1",
		"@storybook/react-webpack5": "10.6.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/jest": "^30.0.0",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/babel-preset-default": "^9.0.0",
		"@wordpress/browserslist-config": "^6.57.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/compose": "^8.10.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/postcss-plugins-preset": "^5.57.0",
		"@wordpress/prettier-config": "^4.57.0",
		"@wordpress/scripts": "^36.1.0",
		"css-loader": "^7.1.2",
		"eslint-formatter-pretty": "^7.1.0",
		"fs-extra": "^11.4.1",
		"glob": "^13.0.6",
		"globals": "^16.5.0",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"lerna": "^9.0.3",
		"postcss": "^8.5.29",
		"postcss-loader": "6.2.1",
		"prettier": "npm:wp-prettier@^3.9.6",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"rimraf": "^6.0.1",
		"sass": "^1.105.1",
		"sass-loader": "16.0.3",
		"storybook": "10.6.1",
		"style-loader": "^4.0.0"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	]
}
